# UO login credentials for scripts/demo_with_classicuo.sh.
#
# Usage:
#   1. Copy this file to scripts/credentials.env (already git-ignored).
#   2. Fill in the values below.
#   3. Run scripts/demo_with_classicuo.sh — it will auto-source the file.
#
# Any value already exported in your shell takes precedence over what
# is listed here, so you can also run:
#   CUO_USER=otheracct CUO_PASS=... scripts/demo_with_classicuo.sh

# Account name the shard knows you by.
CUO_USER=admin

# Password. For uo.hulryung.com this is the hashed form ClassicUO
# expects (same string you'd put in classicuo/settings.json).
CUO_PASS=1-210E170616545C40

# Optional overrides (uncomment to use):
# UPSTREAM=uo.hulryung.com:2593
# LISTEN=127.0.0.1:2593
# INTENT_PREFIX="[i "
# CLIENT_VERSION=7.0.102.3
# UOPATH=/Users/dkkang/dev/uo/uo-resource
